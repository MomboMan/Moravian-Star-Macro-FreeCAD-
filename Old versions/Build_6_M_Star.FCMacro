import math
import FreeCAD as App
import Part
from PySide import QtWidgets, QtCore

class MoravianStarDialog(QtWidgets.QDialog):
    def __init__(self):
        super(MoravianStarDialog, self).__init__()
        self.init_ui()
        
    def init_ui(self):
        self.setWindowTitle("12-Point Moravian Star Generator")
        self.resize(320, 200)
        
        # Main vertical layout
        layout = QtWidgets.QVBoxLayout()
        grid = QtWidgets.QGridLayout()
        
        # Form inputs: Labels & SpinBoxes
        grid.addWidget(QtWidgets.QLabel("Base Radius (mm):"), 0, 0)
        self.radius_input = QtWidgets.QDoubleSpinBox()
        self.radius_input.setRange(1.0, 500.0)
        self.radius_input.setValue(2.5)
        grid.addWidget(self.radius_input, 0, 1)
        
        grid.addWidget(QtWidgets.QLabel("Spike Height (mm):"), 1, 0)
        self.height_input = QtWidgets.QDoubleSpinBox()
        self.height_input.setRange(1.0, 1000.0)
        self.height_input.setValue(20.0)
        grid.addWidget(self.height_input, 1, 1)
        
        grid.addWidget(QtWidgets.QLabel("Sides:"), 2, 0)
        self.sides_input = QtWidgets.QSpinBox()
        self.sides_input.setRange(3, 20)
        self.sides_input.setValue(5)
        grid.addWidget(self.sides_input, 2, 1)
        
        # NEW: Create Hole Toggle (Checkbox)
        grid.addWidget(QtWidgets.QLabel("Create Mount Hole:"), 3, 0)
        self.hole_toggle = QtWidgets.QCheckBox()
        self.hole_toggle.setChecked(True)
        self.hole_toggle.stateChanged.connect(self.toggle_hole_inputs)
        grid.addWidget(self.hole_toggle, 3, 1)
        
        grid.addWidget(QtWidgets.QLabel("Mount Hole Diameter (mm):"), 4, 0)
        self.hole_dia_input = QtWidgets.QDoubleSpinBox()
        self.hole_dia_input.setRange(0.0, 200.0)
        self.hole_dia_input.setValue(2.5)
        grid.addWidget(self.hole_dia_input, 4, 1)
        
        grid.addWidget(QtWidgets.QLabel("Mount Hole Depth (mm):"), 5, 0)
        self.hole_depth_input = QtWidgets.QDoubleSpinBox()
        self.hole_depth_input.setRange(0.0, 500.0)
        self.hole_depth_input.setValue(3.75)
        grid.addWidget(self.hole_depth_input, 5, 1)
        
        layout.addLayout(grid)
        
        # Action Button
        self.generate_btn = QtWidgets.QPushButton("Generate Star")
        self.generate_btn.clicked.connect(self.on_generate)
        layout.addWidget(self.generate_btn)
        
        self.setLayout(layout)
        
    def toggle_hole_inputs(self, state):
        # Dynamically gray out or enable fields based on checkbox state
        has_hole = (state == QtCore.Qt.Checked)
        self.hole_dia_input.setEnabled(has_hole)
        self.hole_depth_input.setEnabled(has_hole)
        if not has_hole: 
            self.hole_dia_input.setValue(0.0)
            self.hole_depth_input.setValue(0.0)
        
    def on_generate(self):
        r = self.radius_input.value()
        h = self.height_input.value()
        sides = self.sides_input.value()
        
        # Automatically pass 0 if the toggle is turned off
        if self.hole_toggle.isChecked():
            h_dia = self.hole_dia_input.value()
            h_depth = self.hole_depth_input.value()
        else:
            h_dia = 0.0
            h_depth = 0.0
            
        build_mountable_12_point_star(r, h, sides, h_dia, h_depth)
        self.accept() 

def build_mountable_12_point_star(base_radius, point_height, sides, hole_diameter, hole_depth):
    doc = App.activeDocument()
    if not doc:
        doc = App.newDocument("MoravianStar12_Mountable")
      
    try:
        phi = (1.0 + math.sqrt(5.0)) / 2.0  # Constant gold ratio for icosahedral tracking
        
        true_12_axes = [
            (0, 1, phi),   (0, 1, -phi),  (0, -1, phi),  (0, -1, -phi),
            (1, phi, 0),   (1, -phi, 0),  (-1, phi, 0),  (-1, -phi, 0),
            (phi, 0, 1),   (phi, 0, -1),  (-phi, 0, 1),  (-phi, 0, -1)
        ]
        
        # 1. Build a sharp, solid X-sided pyramid pointing straight up (Z-axis)
        base_verts = []
        for i in range(sides):
            angle = i * (2 * math.pi / sides)
            x_val = base_radius * math.cos(angle)
            y_val = base_radius * math.sin(angle)
            
            # PADDING FIX: Extending the base slightly inside the negative Z realm 
            # provides a solid unified intersection core for 3-sided geometry fusions.
            z_val = -base_radius * 0.5 if sides == 3 else 0.0
            base_verts.append(App.Vector(x_val, y_val, z_val))
            
        tip = App.Vector(0, 0, point_height)
        pyramid_faces = []
        
        for i in range(sides):
            v1 = base_verts[i]
            v2 = base_verts[(i + 1) % sides]
            wire = Part.Wire([Part.makeLine(v1, v2), Part.makeLine(v2, tip), Part.makeLine(tip, v1)])
            pyramid_faces.append(Part.Face(wire))
            
        base_edges = [Part.makeLine(base_verts[i], base_verts[(i + 1) % sides]) for i in range(sides)]
        pyramid_faces.append(Part.Face(Part.Wire(base_edges)))
        
        single_point = Part.makeSolid(Part.makeShell(pyramid_faces))
        
        star_shape = None
        
        # 2. Duplicate, rotate, and fuse the points into the 12 spatial directions
        for ax in true_12_axes:
            ax_x, ax_y, ax_z = ax[0], ax[1], ax[2]
            target_direction = App.Vector(ax_x, ax_y, ax_z).normalize()
            
            spike = single_point.copy()
            
            z_axis = App.Vector(0, 0, 1)
            rotation_axis = z_axis.cross(target_direction)
            
            if rotation_axis.Length > 0.0001:
                rotation_axis.normalize()
                angle_deg = math.degrees(math.acos(z_axis.dot(target_direction)))
                spike.rotate(App.Vector(0,0,0), rotation_axis, angle_deg)
                
            if star_shape is None:
                star_shape = spike
            else:
                star_shape = star_shape.fuse(spike)
                
        wall_thickness = 1.5  # Desired plastic wall thickness in mm
        
        # 1. Create an inner hollow core tool by making a smaller copy of the fused star
        # We shrink it by moving the faces inward along their normals
        try:
            # Negative offset hollows it inward
            inner_void = star_shape.makeOffsetShape(-wall_thickness, 0.001, False) 
            # Cut the inner void out of the main shape to leave a hollow shell
            star_shape = star_shape.cut(inner_void)
        except Exception as shell_err:
            print("Hollowing failed, defaulting to solid core: " + str(shell_err))
 
        hole_radius = hole_diameter / 2.0

        # 3.2 Cut out the post pocket if size parameters are greater than 0
        if hole_diameter > 0 and hole_depth > 0:
            mount_tool = Part.makeCylinder(hole_radius, hole_depth*2, App.Vector(0, 0, -hole_depth*2), App.Vector(0, 0, 1), 360)
            star_shape = star_shape.cut(mount_tool)

        # 4. Create raw part feature and attach to document tree
        star_feature = doc.addObject("Part::Feature", "MoravianStarShape")
        star_feature.Shape = star_shape

        body = doc.addObject("PartDesign::Body", "MoravianStarBody")
        
        if hole_diameter > 0 and hole_depth > 0:
            body.Label = "M-Star(" + str(sides) + ") " + str(base_radius) + " br " + str(point_height) + " sh " + str(hole_radius) + " hdia " + str(hole_depth) + " hdep"
        else:
            body.Label = "M-Star(" + str(sides) + ") " + str(base_radius) + " br " + str(point_height) + " sh"
            
        # Nest the feature inside the Body group container
        body.Group = [star_feature]
        doc.recompute()
        
        if App.GuiUp:
            import FreeCADGui as Gui
            Gui.ActiveDocument.ActiveView.fitAll()
            Gui.Selection.clearSelection()
            
            # FIX: The correct API pathway to bold and activate the body for sketches
            Gui.ActiveDocument.ActiveView.setActiveObject("pdbody", body)
            
        print("Success! Custom parameterized star generated cleanly.")        

    except Exception as err:
        print("Generation failed: " + str(err))
                
# Launch dialog safely
dialog = MoravianStarDialog()
dialog.exec()